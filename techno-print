<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تكنو برنت | Amr Elshbeny</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background: radial-gradient(circle at 10% 20%, rgba(30, 20, 60, 1) 0%, rgba(15, 18, 35, 1) 50%, rgba(10, 12, 25, 1) 90%);
            color: #e2e8f0;
            min-height: 100vh;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 15px 35px 0 rgba(0, 0, 0, 0.4), inset 0 1px 0 0 rgba(255, 255, 255, 0.2);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.25);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(168, 85, 247, 0.4);
            box-shadow: 0 15px 35px rgba(168, 85, 247, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.4);
            transform: translateY(-3px);
        }

        .glass-btn-primary {
            background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .glass-btn-primary:hover {
            background: linear-gradient(135deg, #b666ff 0%, #7c3aed 100%);
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.6);
        }

        .glow-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgba(15, 18, 35, 0.5); }
        ::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.3); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(168, 85, 247, 0.6); }
    </style>
</head>
<body class="p-4 md:p-8 relative overflow-x-hidden">

    <!-- Ambient Lights -->
    <div class="glow-orb w-96 h-96 bg-purple-600/30 -top-20 -left-20"></div>
    <div class="glow-orb w-96 h-96 bg-blue-600/20 bottom-10 right-10"></div>

    <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row gap-6">

        <!-- Sidebar -->
        <aside class="w-full md:w-20 glass-panel rounded-3xl p-4 flex md:flex-col items-center justify-between gap-6">
            <div class="w-12 h-12 rounded-2xl glass-btn-primary flex items-center justify-center text-white text-xl font-bold shadow-lg">
                TP
            </div>
            <nav class="flex md:flex-col gap-4 text-gray-400">
                <button class="w-12 h-12 rounded-2xl glass-card flex items-center justify-center text-purple-400 border-purple-500/50" title="المخزن"><i class="fa-solid fa-boxes-stacked text-lg"></i></button>
                <button onclick="exportExcel()" class="w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:text-emerald-400" title="تصدير إكسيل"><i class="fa-solid fa-file-excel text-lg"></i></button>
                <button onclick="exportJSON()" class="w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:text-cyan-400" title="تصدير JSON"><i class="fa-solid fa-download text-lg"></i></button>
                <button onclick="document.getElementById('importFile').click()" class="w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:text-cyan-400" title="استيراد JSON"><i class="fa-solid fa-upload text-lg"></i></button>
                <input type="file" id="importFile" class="hidden" accept=".json" onchange="importJSON(event)">
            </nav>
            <div class="hidden md:block">
                <button onclick="openSettingsModal()" class="w-10 h-10 rounded-full glass-card flex items-center justify-center text-gray-400 hover:text-white" title="الإعدادات"><i class="fa-solid fa-gear"></i></button>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="flex-1 flex flex-col gap-6">

            <!-- Top Header -->
            <header class="glass-panel rounded-3xl p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <h1 id="appTitleHeader" class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400">
                        تكنو برنت
                    </h1>
                    <div class="text-sm font-semibold tracking-wider text-purple-300 mt-0.5">
                        Amr Elshbeny
                    </div>
                    <p class="text-xs text-gray-400 mt-1">نظام إدارة مخزن التابلوهات والبراويز الذكي</p>
                </div>

                <div class="flex items-center gap-3 w-full md:w-auto">
                    <!-- Export Excel Button -->
                    <button onclick="exportExcel()" class="px-4 py-2.5 rounded-2xl glass-card text-emerald-400 hover:bg-emerald-500/20 text-xs font-bold flex items-center gap-2 border-emerald-500/30">
                        <i class="fa-solid fa-file-excel text-sm"></i> تصدير إكسيل
                    </button>
                    <!-- Search Input -->
                    <div class="relative w-full md:w-72">
                        <input type="text" id="searchInput" oninput="renderTable()" placeholder="ابحث باسم القطعة..." 
                            class="w-full bg-white/5 border border-white/10 rounded-2xl py-2.5 px-10 text-sm focus:outline-none focus:border-purple-500/50 text-white placeholder-gray-400">
                        <i class="fa-solid fa-magnifying-glass absolute right-3 top-3 text-gray-400 text-sm"></i>
                    </div>
                </div>
            </header>

            <!-- Stats Bar -->
            <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="glass-card rounded-2xl p-4 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-purple-500/20 border border-purple-500/30 flex items-center justify-center text-purple-400 text-xl"><i class="fa-solid fa-cubes"></i></div>
                    <div>
                        <div class="text-xs text-gray-400">إجمالي الأنواع</div>
                        <div id="statTotalItems" class="text-xl font-bold text-white">0</div>
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-4 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xl"><i class="fa-solid fa-layer-group"></i></div>
                    <div>
                        <div class="text-xs text-gray-400">إجمالي القطع</div>
                        <div id="statTotalQty" class="text-xl font-bold text-white">0</div>
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-4 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 text-xl"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <div>
                        <div class="text-xs text-gray-400">منخفض المخزون</div>
                        <div id="statLowStock" class="text-xl font-bold text-amber-300">0</div>
                    </div>
                </div>
                <div class="glass-card rounded-2xl p-4 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-red-500/20 border border-red-500/30 flex items-center justify-center text-red-400 text-xl"><i class="fa-solid fa-circle-xmark"></i></div>
                    <div>
                        <div class="text-xs text-gray-400">منتهي (نواقص)</div>
                        <div id="statOutStock" class="text-xl font-bold text-red-400">0</div>
                    </div>
                </div>
            </section>

            <!-- Form & Table Area -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Add Form Card -->
                <div class="glass-panel rounded-3xl p-6 flex flex-col gap-4">
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-square-plus text-purple-400"></i> إضافة قطعة جديدة
                    </h2>

                    <div>
                        <label class="text-xs text-gray-400 mb-1 block">نوع المنتج</label>
                        <select id="prodType" onchange="updateSizesAndOptions()" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                            <option value="كانفاس" class="bg-slate-900">كانفاس (Canvas)</option>
                            <option value="فريم" class="bg-slate-900">فريم (Frame)</option>
                        </select>
                    </div>

                    <div id="frameOptionGroup">
                        <label class="text-xs text-gray-400 mb-1 block">خيار الفريم</label>
                        <select id="prodOption" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                            <option value="بدون فريم" class="bg-slate-900">بدون فريم</option>
                            <option value="بفريم" class="bg-slate-900">بفريم</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs text-gray-400 mb-1 block">المقاس القياسي</label>
                        <select id="prodSize" onchange="toggleCustomSize()" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                        </select>
                    </div>

                    <div id="customSizeGroup" class="hidden">
                        <label class="text-xs text-gray-400 mb-1 block">مقاس مخصص (مثال: 70x100)</label>
                        <input type="text" id="customSizeInput" placeholder="70x100" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-gray-400 mb-1 block">الكمية الحالية</label>
                            <input type="number" id="prodQty" min="0" value="1" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 mb-1 block">الحد الأدنى للتنبيه</label>
                            <input type="number" id="prodMin" min="0" value="3" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                        </div>
                    </div>

                    <button onclick="addItem()" class="glass-btn-primary rounded-xl py-3 font-bold text-white mt-2 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus"></i> إدراج للمخزن
                    </button>
                </div>

                <!-- Table Card -->
                <div class="lg:col-span-2 glass-panel rounded-3xl p-6 flex flex-col gap-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-cyan-400"></i> قائمة المخزون
                        </h2>
                        <!-- Filters -->
                        <div class="flex gap-2 text-xs">
                            <button onclick="setFilter('all')" id="filter-all" class="px-3 py-1.5 rounded-lg bg-purple-500/30 text-purple-300 border border-purple-500/50">الكل</button>
                            <button onclick="setFilter('كانفاس')" id="filter-كانفاس" class="px-3 py-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-white">كانفاس</button>
                            <button onclick="setFilter('فريم')" id="filter-فريم" class="px-3 py-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-white">فريم</button>
                            <button onclick="setFilter('low')" id="filter-low" class="px-3 py-1.5 rounded-lg bg-white/5 text-amber-400 hover:text-amber-300">النواقص</button>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-sm">
                            <thead>
                                <tr class="text-gray-400 border-b border-white/10">
                                    <th class="p-3">اسم القطعة</th>
                                    <th class="p-3">المقاس</th>
                                    <th class="p-3">الكمية</th>
                                    <th class="p-3">الحالة</th>
                                    <th class="p-3 text-center">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="inventoryTable">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="fixed inset-0 bg-black/60 backdrop-blur-md hidden z-50 flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-3xl p-6 flex flex-col gap-4 relative">
            <button onclick="closeSettingsModal()" class="absolute top-4 left-4 text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-gear text-purple-400"></i> إعدادات التطبيق
            </h3>
            
            <div class="flex flex-col gap-3">
                <div>
                    <label class="text-xs text-gray-400 mb-1 block">اسم المخزن / المؤسسة</label>
                    <input type="text" id="settingAppName" value="تكنو برنت - Amr Elshbeny" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                </div>

                <div>
                    <label class="text-xs text-gray-400 mb-1 block">الحد الأدنى الافتراضي للقطع الجديدة</label>
                    <input type="number" id="settingDefaultMin" value="3" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-purple-500">
                </div>

                <div class="border-t border-white/10 pt-3 mt-2">
                    <button onclick="clearAllData()" class="w-full py-2.5 rounded-xl bg-red-500/20 text-red-400 hover:bg-red-500/30 text-xs font-bold border border-red-500/30 transition-all">
                        <i class="fa-solid fa-trash-can ml-1"></i> مسح كافة البيانات وإعادة الضبط
                    </button>
                </div>
            </div>

            <button onclick="saveSettings()" class="glass-btn-primary rounded-xl py-3 font-bold text-white mt-2">حفظ الإعدادات</button>
        </div>
    </div>

    <script>
        const canvasSizes = ["50x80", "60x90", "120x80", "150x100", "100x100", "120x180", "120x120", "مخصص"];
        const frameSizes = ["20x30", "30x40", "40x60", "50x70", "60x90", "120x80", "مخصص"];
        
        let inventory = JSON.parse(localStorage.getItem('techno_amr_inventory')) || [
            { id: 1, name: "كانفاس بدون فريم 60x90", type: "كانفاس", option: "بدون فريم", size: "60x90", qty: 12, min: 3 },
            { id: 2, name: "فريم بفريم 40x60", type: "فريم", option: "بفريم", size: "40x60", qty: 2, min: 5 }
        ];

        let settings = JSON.parse(localStorage.getItem('techno_amr_settings')) || {
            appName: "تكنو برنت - Amr Elshbeny",
            defaultMin: 3
        };

        let currentFilter = 'all';

        function saveToStorage() {
            localStorage.setItem('techno_amr_inventory', JSON.stringify(inventory));
            renderTable();
        }

        function updateSizesAndOptions() {
            const type = document.getElementById('prodType').value;
            const sizeSelect = document.getElementById('prodSize');
            const optionGroup = document.getElementById('frameOptionGroup');
            const optionSelect = document.getElementById('prodOption');

            sizeSelect.innerHTML = '';
            const sizes = type === 'كانفاس' ? canvasSizes : frameSizes;
            
            sizes.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s;
                opt.textContent = s;
                opt.className = 'bg-slate-900';
                sizeSelect.appendChild(opt);
            });

            if(type === 'فريم') {
                optionSelect.value = 'بفريم';
                optionGroup.classList.add('hidden');
            } else {
                optionGroup.classList.remove('hidden');
            }

            toggleCustomSize();
        }

        function toggleCustomSize() {
            const sizeSelect = document.getElementById('prodSize');
            const customGroup = document.getElementById('customSizeGroup');
            if(sizeSelect.value === 'مخصص') {
                customGroup.classList.remove('hidden');
            } else {
                customGroup.classList.add('hidden');
            }
        }

        function addItem() {
            const type = document.getElementById('prodType').value;
            const option = type === 'فريم' ? 'بفريم' : document.getElementById('prodOption').value;
            let size = document.getElementById('prodSize').value;
            
            if(size === 'مخصص') {
                size = document.getElementById('customSizeInput').value.trim();
                if(!size) return alert('يرجى إدخال المقاس المخصص');
            }

            const qty = parseInt(document.getElementById('prodQty').value) || 0;
            const min = parseInt(document.getElementById('prodMin').value) || settings.defaultMin;
            const name = `${type} ${option} ${size}`;

            inventory.push({ id: Date.now(), name, type, option, size, qty, min });
            saveToStorage();
        }

        function changeQty(id, delta) {
            const item = inventory.find(i => i.id === id);
            if(item) {
                item.qty = Math.max(0, item.qty + delta);
                saveToStorage();
            }
        }

        function deleteItem(id) {
            if(confirm('هل أنت تأكد من حذف هذه القطعة؟')) {
                inventory = inventory.filter(i => i.id !== id);
                saveToStorage();
            }
        }

        function setFilter(filter) {
            currentFilter = filter;
            document.querySelectorAll('[id^="filter-"]').forEach(btn => {
                btn.className = "px-3 py-1.5 rounded-lg bg-white/5 text-gray-400 hover:text-white";
            });
            document.getElementById(`filter-${filter}`).className = "px-3 py-1.5 rounded-lg bg-purple-500/30 text-purple-300 border border-purple-500/50";
            renderTable();
        }

        function renderTable() {
            const tbody = document.getElementById('inventoryTable');
            const search = document.getElementById('searchInput').value.toLowerCase();
            tbody.innerHTML = '';

            let filtered = inventory.filter(i => {
                const matchesSearch = i.name.toLowerCase().includes(search);
                if(currentFilter === 'all') return matchesSearch;
                if(currentFilter === 'low') return matchesSearch && i.qty <= i.min;
                return matchesSearch && i.type === currentFilter;
            });

            // Stats
            document.getElementById('statTotalItems').innerText = inventory.length;
            document.getElementById('statTotalQty').innerText = inventory.reduce((acc, item) => acc + item.qty, 0);
            document.getElementById('statLowStock').innerText = inventory.filter(i => i.qty > 0 && i.qty <= i.min).length;
            document.getElementById('statOutStock').innerText = inventory.filter(i => i.qty === 0).length;

            filtered.forEach(item => {
                let statusBadge = '';
                if(item.qty === 0) {
                    statusBadge = `<span class="px-2.5 py-1 rounded-full text-xs bg-red-500/20 text-red-400 border border-red-500/30">نفذت الشحنة</span>`;
                } else if(item.qty <= item.min) {
                    statusBadge = `<span class="px-2.5 py-1 rounded-full text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30">مخزون منخفض</span>`;
                } else {
                    statusBadge = `<span class="px-2.5 py-1 rounded-full text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">متوفر</span>`;
                }

                const tr = document.createElement('tr');
                tr.className = "border-b border-white/5 hover:bg-white/5 transition-colors";
                tr.innerHTML = `
                    <td class="p-3 font-semibold text-white">${item.name}</td>
                    <td class="p-3 text-gray-300">${item.size}</td>
                    <td class="p-3">
                        <div class="flex items-center gap-2">
                            <button onclick="changeQty(${item.id}, -1)" class="w-7 h-7 rounded-lg glass-card flex items-center justify-center text-gray-300 hover:text-white">-</button>
                            <span class="font-bold text-purple-300 w-8 text-center">${item.qty}</span>
                            <button onclick="changeQty(${item.id}, 1)" class="w-7 h-7 rounded-lg glass-card flex items-center justify-center text-gray-300 hover:text-white">+</button>
                        </div>
                    </td>
                    <td class="p-3">${statusBadge}</td>
                    <td class="p-3 text-center">
                        <button onclick="deleteItem(${item.id})" class="text-red-400 hover:text-red-300 p-2"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        /* Excel Export Functionality */
        function exportExcel() {
            const excelData = inventory.map(item => ({
                "اسم القطعة": item.name,
                "النوع": item.type,
                "الخيار": item.option,
                "المقاس": item.size,
                "الكمية الحالية": item.qty,
                "الحد الأدنى": item.min,
                "حالة المخزون": item.qty === 0 ? "منتهي" : (item.qty <= item.min ? "منخفض" : "متوفر")
            }));

            const worksheet = XLSX.utils.json_to_sheet(excelData);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "المخزون");

            XLSX.writeFile(workbook, `TechnoPrint_AmrElshbeny_inventory_${new Date().toISOString().slice(0,10)}.xlsx`);
        }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(inventory, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `TechnoPrint_AmrElshbeny_inventory_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importJSON(event) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if(Array.isArray(imported)) {
                        inventory = imported;
                        saveToStorage();
                        alert('تم استيراد البيانات بنجاح!');
                    }
                } catch(err) {
                    alert('ملف JSON غير صالح');
                }
            };
            reader.readAsText(event.target.files[0]);
        }

        /* Settings Functions */
        function openSettingsModal() {
            document.getElementById('settingAppName').value = settings.appName;
            document.getElementById('settingDefaultMin').value = settings.defaultMin;
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

        function saveSettings() {
            settings.appName = document.getElementById('settingAppName').value || "تكنو برنت - Amr Elshbeny";
            settings.defaultMin = parseInt(document.getElementById('settingDefaultMin').value) || 3;
            localStorage.setItem('techno_amr_settings', JSON.stringify(settings));
            closeSettingsModal();
            alert('تم حفظ الإعدادات بنجاح!');
        }

        function clearAllData() {
            if(confirm('هل أنت متأكد من مسح جميع بيانات المخزن؟ لا يمكن التراجع عن هذه الخطوة!')) {
                inventory = [];
                saveToStorage();
                closeSettingsModal();
            }
        }

        // Init
        updateSizesAndOptions();
        renderTable();
    </script>
</body>
</html>
